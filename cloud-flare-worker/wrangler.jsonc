{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spark-hub-studio",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "spark-hub.online/*", "zone_name": "spark-hub.online" },
    { "pattern": "www.spark-hub.online/*", "zone_name": "spark-hub.online" }
  ],
  "assets": {
    "directory": "../artifacts/spark-hub-studio/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "API_BASE_URL": "https://api.spark-hub.online"
  }
}